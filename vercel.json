      "destination": "/personnage/classes/",
      "permanent": true
    },
    {
      "source": "/guide-cra/",
      "destination": "/personnage/classes/cra/",
      "permanent": true
    },
    {
      "source": "/guide-feca/",
      "destination": "/personnage/classes/feca/",
      "permanent": true
